# --- Data Provider (Example: Alpaca - Replace if using Polygon/Tiingo etc.) ---
# ALPACA_API_KEY="YOUR_ALPACA_KEY"
# ALPACA_SECRET_KEY="YOUR_ALPACA_SECRET"
# ALPACA_PAPER="true" # Use 'false' for live trading

# --- Schwab Credentials (Used by schwab-py - STORE SECURELY) ---
# SCHWAB_API_KEY="YOUR_SCHWAB_APP_KEY" # From your Schwab developer app
# SCHWAB_SECRET_KEY="YOUR_SCHWAB_APP_SECRET"
# SCHWAB_ACCOUNT_NUMBER="YOUR_ACCOUNT_NUMBER_HASH" # schwab-py often needs the hashed version
# SCHWAB_USERNAME="YOUR_SCHWAB_USERNAME" # Potentially needed for token refresh
# SCHWAB_PASSWORD="YOUR_SCHWAB_PASSWORD" # Potentially needed for token refresh - EXTREME CAUTION
# SCHWAB_TOTP_SECRET="YOUR_TOTP_SECRET" # If using 2FA Time-based One-Time Password

# --- Other ---
FRED_API_KEY="YOUR_FRED_API_KEY" # Optional: For FRED macro data
